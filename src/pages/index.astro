---
import DocumentEditor from "@/components/DocumentEditor.tsx";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sampleDocument } from "@/lib/dotforge";

// No request-time logic: build this page once and serve it from the CDN
// instead of invoking the Worker per request.
export const prerender = true;
---

<BaseLayout pageTitle="Dotforge - Editor">
  <DocumentEditor doc={sampleDocument()} client:load />
</BaseLayout>
